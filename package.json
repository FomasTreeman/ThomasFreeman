{
	"name": "thomasfreeman",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"db:init:staging": "dotenv -e .env.staging -- npx tsx scripts/init-turso-db.ts",
		"db:seed:staging": "dotenv -e .env.staging -- npx tsx scripts/seed-structured-content.ts",
		"db:init:production": "dotenv -e .env.production -- npx tsx scripts/init-turso-db.ts",
		"db:seed:production": "dotenv -e .env.production -- npx tsx scripts/seed-structured-content.ts",
		"db:migrate:staging": "dotenv -e .env.staging -- npx tsx scripts/migrate-db.ts",
		"db:migrate:production": "dotenv -e .env.production -- npx tsx scripts/migrate-db.ts"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/three": "^0.155.1",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^16.5.0",
		"js-base64": "^3.9.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"saos": "^1.3.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-loading-spinners": "^0.3.6",
		"svelte-markdown": "^0.3.0",
		"three": "^0.155.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vitest": "^2.1.9"
	},
	"type": "module",
	"packageManager": "pnpm@9.12.3",
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@vercel/blob": "^1.1.1",
		"locomotive-scroll": "^4.1.4",
		"mdsvex": "^0.12.8",
		"nanoid": "^5.1.16",
		"resend": "^6.18.1",
		"svelte-cubed": "^0.2.1"
	}
}
